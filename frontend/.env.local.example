# Copy to .env.local.
# Local backend (docker compose --profile full up). All API calls run on the Next.js server; the session token stays in an httpOnly cookie.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Or the mock API (docker compose --profile mock up, from the repository root):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4010
# Help link on every page (mailto: or https:). Without it the placeholder in messages (shell.helpUrl) is used.
# HELP_URL=mailto:...
