# Copy to .env. Never commit .env (the repository becomes public).
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me

# Backend
# At least 32 characters, or every admin call is refused.
ADMIN_TOKEN=change-me-long-random-string-of-at-least-32-chars
CORS_ORIGINS=http://localhost:3000
ANTHROPIC_API_KEY=
FRESHNESS_DAYS=30

# Source tokens. data/sources/registry.json names each variable in "tokenEnv" (see registry.example.json).
# Add a line here for every new source that needs a token. GET /api/v1/admin/source-config shows which are set.
OPENALEX_API_KEY=
GUS_BDL_CLIENT_ID=
# EXAMPLE_SOURCE_TOKEN=

# Sign-in (docs/api/AUTH-PROVIDERS.md). Only the sandbox works today.
AUTH_PROVIDERS=sandbox_id
# Secret for pairwise identity subjects. Long and random. Never change it without a migration.
IDENTITY_PEPPER=
# Węzeł Krajowy (login.gov.pl). Values come from COI after the first signed letter.
# WK_ENV=int
# WK_ISSUER=
# WK_PROVIDER_NAME=
# WK_ACS_URL=https://demo.delta43.net/api/v1/auth/login_gov_pl/acs
# Key files are mounted into the container. They are never in git or in the image.
# WK_SIGN_KEY_FILE=/run/secrets/wk-sign.key
# WK_SIGN_CERT_FILE=/run/secrets/wk-sign.crt
# WK_ENC_KEY_FILE=/run/secrets/wk-enc.key
# WK_ENC_CERT_FILE=/run/secrets/wk-enc.crt
# WK_TRUST_CA_FILE=/run/secrets/login-gov-pl-ca.pem

# Languages the API serves. The first one is the default and the fallback. Ukrainian texts are machine translations
# made by the worker (needs ANTHROPIC_API_KEY); run `python -m app.translate --backfill` once after a deploy.
SUPPORTED_LANGUAGES=pl,en,uk
# Shared sandbox identities (comma separated): no per-identity sign-in limit, cannot be deleted.
DEMO_IDENTITIES=demo-jury
# Web origin used for card links in relatedWork.
PUBLIC_WEB_URL=http://localhost:3000
# Collectors: largest response read, and private-network fetches (keep false outside local development: SSRF guard).
FETCH_MAX_BYTES=25000000
FETCH_ALLOW_PRIVATE=false
# Largest PDF a collector reads, in pages.
PDF_MAX_PAGES=400
# Peers allowed to set CF-Connecting-IP (the tunnel connector), comma separated IPs or CIDRs. Empty: any peer (G8).
TRUSTED_PROXIES=
# A card about a project that ended longer ago than this is stale.
STALE_PROJECT_YEARS=3

# Frontend
# Browser calls this URL. It is baked in at build time. On delta-server set it to the tunnel host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Mock server for frontend work without the backend:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4010
