# Copy to .env. Never commit .env (the repository becomes public).
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me

# Backend
ADMIN_TOKEN=change-me-long-random-string
CORS_ORIGINS=http://localhost:3000
ANTHROPIC_API_KEY=
OPENALEX_API_KEY=
FRESHNESS_DAYS=30

# Frontend
# Browser calls this URL. It is baked in at build time. On delta-server set it to the tunnel host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Mock server for frontend work without the backend:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4010
